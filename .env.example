OPENROUTER_API_KEY=
JEV_ENABLED=true
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT=3s
JEV_MIN_CONFIDENCE=0.70
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Cores
