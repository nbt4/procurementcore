PORT=8084
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentalcore
DB_USER=rentalcore
DB_PASSWORD=replace-me
DB_SSLMODE=disable
CORES_JWT_SECRET=replace-with-the-shared-cores-secret
COOKIE_DOMAIN=
DASHBOARD_URL=http://localhost:8080
# Optional: Adam Hall Shop account for customer-specific prices and server-side cart ordering.
ADAMHALL_USERNAME=
ADAMHALL_PASSWORD=
